NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/betting_platform?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Google reCAPTCHA. Keep the secret key server-side only.
RECAPTCHA_SECRET_KEY=your-google-recaptcha-secret-key
# v3 minimum score; ignored for checkbox/v2 verification.
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=auth

# API-SPORTS / API-Football. NEVER put the real key in GitHub.
# Add the real value in Render Environment Variables as API_SPORTS_KEY.
API_SPORTS_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# WebSocket
WS_PATH=/ws
