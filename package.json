{
  "name": "betting-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for an original sportsbook platform with live football, custom odds, wallets and gifts.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma@6.19.0 generate && npx tsc -p tsconfig.json",
    "start": "npx tsx src/server.ts",
    "prisma:generate": "npx prisma@6.19.0 generate",
    "prisma:migrate": "npx prisma@6.19.0 migrate dev",
    "prisma:deploy": "npx prisma@6.19.0 migrate deploy",
    "test": "vitest run"
  },
  "engines": { "node": "20.19.x" },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.0.17",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.11",
    "@types/ws": "8.18.1",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
