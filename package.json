{
  "name": "betting-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for an original sportsbook platform with live football, custom odds, wallets and gifts.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma@6.19.0 generate && npx tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma@6.19.0 generate",
    "prisma:migrate": "npx prisma@6.19.0 migrate dev",
    "prisma:deploy": "npx prisma@6.19.0 migrate deploy",
    "test": "vitest run"
  },
  "engines": { "node": "20.19.x" },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "zod": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/ws": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
