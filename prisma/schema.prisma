generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED
}

enum RoleName {
  USER
  ADMIN
  SUPER_ADMIN
  SPORTS_MANAGER
  TRADER
  RISK_MANAGER
  KYC_AGENT
  FINANCE
  SUPPORT
  REPORT_VIEWER
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_REFUND
  BONUS
  GIFT_REWARD
  ADJUSTMENT
}

enum GiftStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum GiftClaimStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?  @unique
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  ageConfirmedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  roles           UserRole[]
  wallet          Wallet?
  giftClaims      GiftClaim[]
  sessions        Session[]
  auditLogs       AuditLog[]
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceMinor BigInt   @default(0)
  lockedMinor  BigInt   @default(0)
  bonusMinor   BigInt   @default(0)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  type          WalletTransactionType
  amountMinor   BigInt
  balanceAfter  BigInt
  reference     String   @unique
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  wallet        Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
}

model Sport {
  id           String @id @default(cuid())
  name         String @unique
  slug         String @unique
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  competitions Competition[]
  events       Event[]
}

model Competition {
  id      String @id @default(cuid())
  sportId String
  name    String
  slug    String
  country String?
  active  Boolean @default(true)
  sport   Sport @relation(fields: [sportId], references: [id])
  events  Event[]

  @@unique([sportId, slug])
}

model Event {
  id            String @id @default(cuid())
  externalId    String?
  sportId       String
  competitionId String
  homeName      String
  awayName      String
  startsAt      DateTime
  status        String @default("SCHEDULED")
  homeScore     Int?
  awayScore     Int?
  minute        Int?
  live          Boolean @default(false)
  metadata      Json?
  updatedAt     DateTime @updatedAt
  sport         Sport @relation(fields: [sportId], references: [id])
  competition   Competition @relation(fields: [competitionId], references: [id])

  @@index([startsAt])
  @@index([live, startsAt])
  @@index([externalId])
}

model Gift {
  id          String @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  type        String
  valueMinor  BigInt?
  stock       Int?
  status      GiftStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  eligibility Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  claims      GiftClaim[]
}

model GiftClaim {
  id        String @id @default(cuid())
  giftId    String
  userId    String
  status    GiftClaimStatus @default(PENDING)
  reference String @unique
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gift      Gift @relation(fields: [giftId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  @@unique([giftId, userId])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
